<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".application.KombineApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KombineApp"
        android:screenOrientation="portrait"
        android:usesCleartextTraffic="true"
        tools:ignore="DiscouragedApi,LockedOrientationActivity"
        tools:targetApi="31">

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".ui.register.RegisterActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.verificationcode.VerificationCodeActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.forgotpassword.ForgotPasswordActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.userdelete.UserDeleteActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.teams.TeamsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.teamdetail.TeamDetailActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.matchdetail.MatchDetailActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.ticketdetail.TicketDetailActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.settings.tickets.TicketsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.home.createticket.CreateTicketActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.settings.tariffs.TariffsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.messages.chat.ChatActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.settings.mytariffs.MyTariffsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.userdetail.UserDetailActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.userdetail.usercomments.UserCommentsActivity"
            android:screenOrientation="portrait" />
    </application>

</manifest>