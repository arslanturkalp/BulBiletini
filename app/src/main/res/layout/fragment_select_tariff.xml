<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.alparslanturk.biletdevret.custom.ApplicationToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTariffs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/btnBuyTariff"
            android:layout_below="@id/toolbar"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            tools:listitem="@layout/row_layout_tariff_item" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBuyTariff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="16dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="32dp"
            android:height="60dp"
            android:background="@drawable/bg_rounded"
            android:backgroundTint="@color/text_selector_default_green"
            android:fontFamily="@font/lato_bold"
            android:text="@string/buy_tariff"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp" />

    </RelativeLayout>

</FrameLayout>